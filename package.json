{
  "name": "headless_dms",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "biome check src tests --diagnostic-level=error",
    "lint:all": "biome check src tests",
    "lint:fix": "biome check src tests --write --unsafe --diagnostic-level=error",
    "fmt:dry": "biome format src",
    "fmt": "biome format src --write",
    "dev": "bun run --watch src/index.ts",
    "build": "tsc",
    "start": "bun run src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "bun run drizzle-kit generate",
    "db:migrate": "bun run drizzle-kit migrate",
    "db:push": "bun run drizzle-kit push",
    "db:seed": "bun run src/infra/db/seed.ts",
    "db:studio": "bun run drizzle-kit studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@faker-js/faker": "^10.3.0",
    "@testcontainers/postgresql": "^11.12.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.3",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "drizzle-kit": "^0.31.9",
    "testcontainers": "^11.12.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.992.0",
    "@aws-sdk/s3-request-presigner": "^3.992.0",
    "@carbonteq/fp": "^0.10.0",
    "@carbonteq/refined-type": "^0.1.1",
    "@effect/schema": "^0.75.5",
    "@orpc/server": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.1",
    "effect": "^3.19.18",
    "hono": "^4.12.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.18.0",
    "postgres": "^3.4.8",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6",
    "zod-validation-error": "^5.0.0"
  }
}
